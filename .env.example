# 环境变量配置示例
# 复制此文件为 .env 并修改配置

# Docker Compose 镜像版本（Git 标签 v2.0.0 对应镜像标签 2.0.0）
ACGO_IMAGE=ghcr.io/yz0812/acgo:2.0.0

# 管理员密码（首次部署请修改）
ADMIN_PASSWORD=acgo123321

# Flask 密钥（可选，已有安全默认值）
SECRET_KEY=a8f5f167f44f4964e6c998dee827110c5b92c0f8d1e3a7b2c4f6e8d0a2b4c6e8

# 新数据库默认开启，每 10 秒小批清理；已有配置通过系统设置修改
AUTO_CLEAN_LOGS=true

# 最大签到记录数（可选，默认：500）
# 当启用自动清理时，保留最新的 N 条记录
MAX_LOGS_COUNT=500

# 1 核 1G 资源预算（启动时读取）
WEB_THREADS=4
HTTP_WORKERS=2
SCRIPT_WORKERS=1
TASK_QUEUE_LIMIT=32
NOTIFY_QUEUE_LIMIT=128
HTTP_BODY_LIMIT=131072
HTTP_DEADLINE=30
SCRIPT_TIMEOUT=60
SCRIPT_MEMORY_MB=192
SCRIPT_PROCESSES=8
# 可选：Linux 上已委派 memory/pids 控制器的 cgroup v2 目录
# SCRIPT_CGROUP_ROOT=/sys/fs/cgroup/acgo-scripts
